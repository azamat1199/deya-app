# Backend origin. Scheme + host only — no trailing slash and no /api suffix:
# every path constant already carries its own /api/v1/ prefix.
#
# NEXT_PUBLIC_ values are inlined into the client bundle at build time and are
# public. Never put a secret here.
NEXT_PUBLIC_API_URL=https://deya.uz

# Public origin of THIS site: canonical, hreflang, og:url, sitemap.xml and
# robots.txt are built from it. Scheme + host, no trailing slash. Set it
# explicitly in every environment — the code falls back to https://deya.uz, but
# a preview deploy should point at itself (or be noindexed) instead.
NEXT_PUBLIC_SITE_URL=https://deya.uz

# Shared secret for POST /api/revalidate (on-demand cache refresh called by the
# Django admin after content changes). Server-only: NO NEXT_PUBLIC_ prefix.
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=
